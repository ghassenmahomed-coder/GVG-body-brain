# Copy to .env.local for local runs. On Vercel, add these under Project > Settings > Environment Variables.

# The code you type to unlock the app. Pick something long.
APP_PASSCODE=
# Random string used to sign the login cookie. Generate one with: openssl rand -hex 32
# Optional. Leave empty to derive the login key from the tokens below.
AUTH_SECRET=

# Todoist > Settings > Integrations > Developer > API token
TODOIST_TOKEN=

# Notion > Settings > Connections > Develop or manage integrations > New integration (Internal).
# Then open the GVG Brain page > ... > Connections > add that integration.
NOTION_TOKEN=
